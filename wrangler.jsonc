{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "urbanmorph",
  "compatibility_date": "2026-09-01",
  // Enable after urbanmorph.com is an active zone on this Cloudflare account (see CUTOVER.md):
  // "routes": [
  //   { "pattern": "www.urbanmorph.com", "custom_domain": true },
  //   { "pattern": "urbanmorph.com", "custom_domain": true }
  // ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
