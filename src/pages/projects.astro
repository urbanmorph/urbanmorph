---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { img } from '../lib/images';
import projects from '../data/projects.json';

const colour: Record<string, string> = { infrastructure: 'var(--green)', technology: 'var(--asphalt)', campaigns: 'var(--yellow)', events: 'var(--blue)' };
const kindColour: Record<string, string> = { infrastructure: 'var(--green)', technology: 'var(--asphalt)', campaigns: 'var(--yellow-ink)', events: 'var(--blue)' };
const categories = [...new Map(projects.map((p) => [p.category, { key: p.category, name: p.categoryName, description: p.categoryDescription }])).values()];
const byCat = (key: string) => projects.filter((p) => p.category === key);
const jsonLd = [{ '@context': 'https://schema.org', '@type': 'ItemList', name: 'Urban Morph projects', numberOfItems: projects.length, itemListElement: projects.map((p, i) => ({ '@type': 'ListItem', position: i + 1, name: p.title, ...(p.link ? { url: p.link.url.startsWith('http') ? p.link.url : `https://www.urbanmorph.com/${p.link.url}` } : {}) })) }];
const description = `${projects.length} projects across infrastructure, technology, campaigns and events: bicycle parking, AltMo, Church Street First, Relief Riders, Cycle Days and more, delivered with cities, institutions and communities across India.`;
---

<Base title="Projects" description={description} jsonLd={jsonLd}>
  <div class="container stack">
    <section class="panel panel--green head">
      <div>
        <h1>Projects</h1>
        <p class="lede">Infrastructure, technology, campaigns and events, delivered with cities, institutions and communities across India.</p>
      </div>
      <span class="head__count">{projects.length} projects, {categories.length} kinds</span>
    </section>

    <nav class="tabs" aria-label="Project kinds">
      {categories.map((c) => (
        <a class="tab" href={`#${c.key}`}><span class="tab__swatch" style={`background: ${colour[c.key]}`}></span>{c.name} <b>{byCat(c.key).length}</b></a>
      ))}
    </nav>

    {categories.map((c) => (
      <section class="section" id={c.key}>
        <div class="section__head">
          <h2>{c.name}</h2>
          <p class="muted kind__desc">{c.description}</p>
        </div>
        <div class="grid grid--3">
          {byCat(c.key).map((p, i) => {
            const image = img(p.image);
            return (
              <article class="card">
                <div class:list={['card__media', { 'card__media--contain': image && image.width / image.height < 1.15 }]} style={`border-bottom-color: ${colour[c.key]}`}>
                  {image && <Image src={image} alt={p.alt || p.title} widths={[400, 640, 900]} quality={65} sizes="(max-width: 620px) 100vw, (max-width: 991px) 50vw, 33vw" loading={c.key === 'infrastructure' && i < 3 ? 'eager' : 'lazy'} fetchpriority={c.key === 'infrastructure' && i === 0 ? 'high' : undefined} />}
                </div>
                <div class="card__body">
                  <span class="card__kind" style={`color: ${kindColour[c.key]}`}>{c.name}</span>
                  <h3>{p.title}</h3>
                  <p>{p.description}</p>
                  {p.credits && <p class="small muted">{p.credits}</p>}
                  {p.link && <a class="card__link" href={p.link.url.startsWith('http') ? p.link.url : `/${p.link.url}`} target="_blank" rel="noopener">{p.link.label}</a>}
                </div>
              </article>
            );
          })}
        </div>
      </section>
    ))}
  </div>
</Base>

<style>
  .head { padding: clamp(24px, 3.5vw, 44px); display: flex; justify-content: space-between; align-items: flex-end; gap: 32px; }
  .head .lede { margin-top: 12px; color: var(--white); }
  .head__count { font-size: 1.2rem; font-weight: 600; white-space: nowrap; }
  .kind__desc { max-width: 60ch; }
  section[id] { scroll-margin-top: 16px; }
  @media (max-width: 720px) { .head { flex-direction: column; align-items: flex-start; } }
</style>
