---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" description="The page you were looking for has moved or never existed." noindex>
  <div class="container stack">
    <section class="board on-yellow nf">
      <h1>No such street.</h1>
      <p class="lede">The page has moved or never existed. Older links from the previous site redirect on their own, so if you typed the address, check it, or start from one of these.</p>
      <div class="nf__links">
        <a class="btn btn--dark" href="/">Home</a>
        <a class="btn btn--white" href="/projects/">Projects</a>
        <a class="btn btn--white" href="/blog/">Blog</a>
        <a class="btn btn--white" href="/synthesys/">SyntheSYS</a>
      </div>
    </section>
  </div>
</Base>

<style>
  .nf { padding: clamp(28px, 5vw, 64px); display: flex; flex-direction: column; gap: 18px; align-items: flex-start; }
  .nf__links { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 8px; }
</style>
