---
import Base from '../layouts/Base.astro';
import media from '../data/media.json';

const total = media.reduce((n, s) => n + s.items.length, 0);
const description = `${total} stories on Urban Morph's work in the press: AltMo, the Active Mobility Centre of Excellence, Relief Riders, Church Street First, Cycle Days and Bengaluru's Bicycle Mayor.`;
const badgeClass = (b: string) => (b.startsWith('Award') ? 'tag--yellow' : b === 'Milestone' ? 'tag--green' : 'tag--blue');
---

<Base title="Media coverage" description={description}>
  <div class="container stack">
    <section class="panel panel--blue head">
      <div>
        <h1>In the press</h1>
        <p class="lede">{total} stories from 2018 to 2026 on Urban Morph's projects, platforms and Bengaluru's Bicycle Mayor.</p>
      </div>
    </section>

    {media.map((sec) => (
      <section class="section">
        <div class="section__head"><h2>{sec.title}</h2><span class="muted">{sec.tag.charAt(0) + sec.tag.slice(1).toLowerCase()}</span></div>
        <div class="stories">
          {sec.items.map((a) => (
            <article class:list={['story', { 'story--featured': a.featured }]}>
              {a.badge && <span class:list={['tag', badgeClass(a.badge)]}>{a.badge}</span>}
              <h3>{a.title}</h3>
              <p>{a.summary}</p>
              <p class="story__meta"><strong>{a.source}</strong>{a.date && <>, {a.date}</>}</p>
              {a.coverage.length > 0 && (
                <ul class="coverage" aria-label="Coverage">
                  {a.coverage.map((c) => <li><a class="tab" href={c.url} target="_blank" rel="noopener">{c.label}</a></li>)}
                </ul>
              )}
            </article>
          ))}
        </div>
      </section>
    ))}
  </div>
</Base>

<style>
  .head { padding: clamp(24px, 3.5vw, 44px); }
  .head .lede { margin-top: 12px; color: var(--white); }
  .stories { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 40px; border-top: 2px solid var(--asphalt); }
  .story { padding: 22px 0; border-bottom: 1px solid var(--rule); display: flex; flex-direction: column; gap: 8px; align-items: flex-start; }
  .story--featured { grid-column: 1 / -1; }
  .story h3 { font-size: 1.5rem; }
  .story--featured h3 { font-size: clamp(1.8rem, 3vw, 2.4rem); font-weight: 800; font-stretch: 85%; }
  .story p { max-width: 80ch; }
  .story__meta { font-size: 0.95rem; color: var(--muted); }
  .story__meta strong { color: var(--asphalt); }
  .coverage { list-style: none; margin: 4px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .coverage .tab { min-height: 40px; padding: 0 14px; font-size: 0.9rem; }
  @media (max-width: 800px) { .stories { grid-template-columns: 1fr; } }
</style>
