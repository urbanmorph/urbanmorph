---
import type { GetStaticPaths } from 'astro';
import Base from '../../../layouts/Base.astro';
import PostCard from '../../../components/PostCard.astro';
import { allPosts, categoriesOf, slugify } from '../../../lib/blog';

export const getStaticPaths = (async () => {
  const posts = await allPosts();
  return categoriesOf(posts).map((c) => ({ params: { category: c.slug }, props: { name: c.name, posts: posts.filter((p) => slugify(p.data.category) === c.slug) } }));
}) satisfies GetStaticPaths;

const { name, posts } = Astro.props;
const all = await allPosts();
const categories = categoriesOf(all);
const current = slugify(name);
---

<Base title={`${name} articles`} description={`${posts.length} Urban Morph articles on ${name}.`}>
  <div class="container stack">
    <section class="panel panel--blue head">
      <div>
        <h1>{name}</h1>
        <p class="lede">{posts.length} {posts.length === 1 ? 'article' : 'articles'} in The Urban Dispatch.</p>
      </div>
    </section>
    <nav class="tabs" aria-label="Categories">
      <a class="tab" href="/blog/">All <b>{all.length}</b></a>
      {categories.map((c) => <a class="tab" href={`/blog/category/${c.slug}/`} aria-current={c.slug === current ? 'page' : undefined}>{c.name} <b>{c.count}</b></a>)}
    </nav>
    <section class="section">
      <h2 class="visually-hidden">Articles in {name}</h2>
      <div class="grid grid--3">{posts.map((p) => <PostCard post={p} />)}</div>
    </section>
  </div>
</Base>

<style>
  .head { padding: clamp(24px, 3.5vw, 44px); }
  .head .lede { margin-top: 12px; color: var(--white); }
</style>
