---
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { allPosts, categoriesOf } from '../../lib/blog';

export const getStaticPaths = (async ({ paginate }) => {
  const posts = await allPosts();
  return paginate(posts, { pageSize: 12 });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const posts = await allPosts();
const categories = categoriesOf(posts);
const isFirst = page.currentPage === 1;
const featured = isFirst ? page.data[0] : null;
const rest = isFirst ? page.data.slice(1) : page.data;
const title = isFirst ? 'Blog' : `Blog, page ${page.currentPage}`;
const description = `Insights on sustainable mobility, climate action and urban policy from Urban Morph: ${posts.length} articles since 2018.`;
---

<Base title={title} description={description}>
  <div class="container stack">
    <section class="panel panel--blue head">
      <div>
        <h1>The Urban Dispatch</h1>
        <p class="lede">{posts.length} articles on mobility, climate action and urban policy, since 2018.</p>
      </div>
    </section>

    <nav class="tabs" aria-label="Categories">
      <a class="tab" href="/blog/" aria-current="page">All <b>{posts.length}</b></a>
      {categories.slice(0, 8).map((c) => <a class="tab" href={`/blog/category/${c.slug}/`}>{c.name} <b>{c.count}</b></a>)}
    </nav>

    {featured && (
      <section class="section" aria-label="Latest article">
        <PostCard post={featured} featured />
      </section>
    )}

    <section class="section">
      <h2 class="visually-hidden">{isFirst ? 'More articles' : 'Articles'}</h2>
      <div class="grid grid--3">{rest.map((p) => <PostCard post={p} />)}</div>
      <nav class="pager" aria-label="Pagination">
        {page.url.prev ? <a class="btn btn--white" href={page.url.prev}>Newer</a> : <span />}
        <span class="muted">Page {page.currentPage} of {page.lastPage}</span>
        {page.url.next ? <a class="btn btn--white" href={page.url.next}>Older</a> : <span />}
      </nav>
    </section>
  </div>
</Base>

<style>
  .head { padding: clamp(24px, 3.5vw, 44px); }
  .head .lede { margin-top: 12px; color: var(--white); }
  .pager { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding-top: 8px; }
</style>
