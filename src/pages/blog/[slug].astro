---
import type { GetStaticPaths } from 'astro';
import { Image, getImage } from 'astro:assets';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { allPosts, formatDate, slugify } from '../../lib/blog';
import { site } from '../../lib/site';
import team from '../../data/team.json';
import { img } from '../../lib/images';

export const getStaticPaths = (async () => {
  const posts = await allPosts();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, related: posts.filter((p) => p.id !== post.id && p.data.category === post.data.category).slice(0, 3).concat(posts.slice(i + 1, i + 4)).filter((p, j, arr) => arr.findIndex((x) => x.id === p.id) === j).slice(0, 3) },
  }));
}) satisfies GetStaticPaths;

const { post, related } = Astro.props;
const { Content } = await render(post);
const { title, description, subtitle, date, category, author, hero, heroUrl, heroCaption } = post.data;
const authorRec = team.find((m) => m.name === author);
const authorPhoto = img(authorRec?.photo);
const pageUrl = `${site.url}/blog/${post.id}/`;
const ogImage = hero ? (await getImage({ src: hero, width: 1200, format: 'jpg' })).src : heroUrl ?? '/og-default.png';
const shareX = `https://twitter.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent(pageUrl)}`;
const shareLi = `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(pageUrl)}`;
const jsonLd = [{
  '@context': 'https://schema.org', '@type': 'BlogPosting', headline: title, description, datePublished: date.toISOString().slice(0, 10), dateModified: date.toISOString().slice(0, 10), inLanguage: 'en-IN', articleSection: category,
  image: new URL(ogImage, site.url).href, url: pageUrl, mainEntityOfPage: pageUrl,
  author: { '@type': 'Person', name: author, jobTitle: authorRec?.role, url: authorRec ? `${site.url}/people/${authorRec.slug}/` : undefined },
  publisher: { '@type': 'Organization', name: site.name, url: site.url, logo: { '@type': 'ImageObject', url: `${site.url}/icon-512.png` } },
}, {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Home', item: site.url + '/' }, { '@type': 'ListItem', position: 2, name: 'Blog', item: site.url + '/blog/' }, { '@type': 'ListItem', position: 3, name: title, item: pageUrl }],
}];
---

<Base title={title} description={description || subtitle || title} type="article" image={ogImage} jsonLd={jsonLd}>
  <div class="container stack">
    <article class="panel panel--white-thin post">
      <header class="post__head">
        <a class="tag tag--blue" href={`/blog/category/${slugify(category)}/`}>{category}</a>
        <h1>{title}</h1>
        {subtitle && <p class="post__sub">{subtitle}</p>}
        <div class="byline">
          {authorPhoto && <Image class="byline__photo" src={authorPhoto} alt="" width={96} height={96} quality={70} />}
          <div>
            <p class="byline__name">{authorRec ? <a href={`/people/${authorRec.slug}/`}>{author}</a> : author}</p>
            <p class="byline__meta">{authorRec?.role ?? 'Urban Morph'}, <time datetime={date.toISOString()}>{formatDate(date)}</time></p>
          </div>
        </div>
      </header>
      {(hero || heroUrl) && (
        <figure class="post__hero">
          {hero ? <Image src={hero} alt={heroCaption ? '' : title} widths={[640, 960, 1400]} sizes="(max-width: 820px) 100vw, 720px" loading="eager" quality={70} /> : <img src={heroUrl} alt="" loading="eager" />}
          {heroCaption && <figcaption class="small muted">{heroCaption}</figcaption>}
        </figure>
      )}
      <div class="prose post__body"><Content /></div>
      <footer class="post__foot">
        <div class="share">
          <a class="btn btn--dark btn--small" href={shareX} target="_blank" rel="noopener">Post on X</a>
          <a class="btn btn--dark btn--small" href={shareLi} target="_blank" rel="noopener">Share on LinkedIn</a>
        </div>
        <a href="/blog/">All articles</a>
      </footer>
    </article>

    {related.length > 0 && (
      <section class="section">
        <h2>Keep reading</h2>
        <div class="grid grid--3">{related.map((p) => <PostCard post={p} />)}</div>
      </section>
    )}
  </div>
</Base>

<style>
  .post { padding: clamp(24px, 4vw, 56px) var(--gutter); display: flex; flex-direction: column; align-items: center; gap: 28px; }
  .post__head, .post__hero, .post__body, .post__foot { width: 100%; max-width: 720px; }
  .post__head { display: flex; flex-direction: column; gap: 16px; align-items: flex-start; }
  .post h1 { font-size: clamp(2.2rem, 4.5vw, 3.75rem); }
  .post__sub { font-size: 1.25rem; line-height: 1.45; color: var(--muted); }
  .byline { display: flex; align-items: center; gap: 14px; padding: 16px 0; border-top: 1px solid var(--rule); border-bottom: 1px solid var(--rule); width: 100%; }
  .byline__photo { width: 48px; height: 48px; object-fit: cover; border-radius: 4px; }
  .byline__name { font-weight: 700; }
  .byline__name a { color: var(--asphalt); text-decoration-color: var(--rule); }
  .byline__name a:hover { text-decoration-color: var(--asphalt); }
  .byline__meta { font-size: 0.9rem; color: var(--muted); }
  .post__hero { margin: 0; }
  .post__hero img { display: block; width: 100%; border-radius: var(--radius); border: 2px solid var(--asphalt); }
  .post__hero figcaption { margin-top: 8px; }
  .post__body { max-width: 720px; }
  .post__foot { display: flex; justify-content: space-between; align-items: center; gap: 16px; flex-wrap: wrap; padding-top: 24px; border-top: 1px solid var(--rule); }
  .share { display: flex; gap: 10px; flex-wrap: wrap; }
</style>
