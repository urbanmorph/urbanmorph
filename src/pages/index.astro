---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { img } from '../lib/images';
import { site, outcomes, focus, ventures } from '../lib/site';
import team from '../data/team.json';
import projects from '../data/projects.json';
import testimonials from '../data/testimonials.json';
import awards from '../data/awards.json';
import partners from '../data/partners.json';

const strandClass = ['panel--green', 'panel--blue', 'panel--asphalt'];
const street = ['Church Street First', 'Bicycle Parking Facilities', 'Cycle Days']
  .map((t) => projects.find((p) => p.title === t))
  .filter((p): p is NonNullable<typeof p> => Boolean(p));
const title = 'Urban Morph | AI-native policy and urban-tech venture studio, Bengaluru';
const jsonLd = [{ '@context': 'https://schema.org', '@type': 'WebSite', name: site.name, url: site.url, description: site.description }];
---

<Base title={title} description={site.description} jsonLd={jsonLd}>
  <div class="container stack">

    <section class="masthead" aria-label="Urban Morph">
      <div class="board on-yellow masthead__board">
        <div class="masthead__text">
          <p class="masthead__kicker">
            {site.kicker.map((k, i) => (
              <><span lang={k.lang}>{k.text}</span>{i < site.kicker.length - 1 && <span class="masthead__slash" aria-hidden="true"> / </span>}</>
            ))}
          </p>
          <h1>Policy, platforms and programmes for Indian cities.</h1>
        </div>
        <div class="masthead__aside">
          <span><strong>Urban Morph</strong></span>
          <span>AI-native, full-stack policy and urban-tech venture studio</span>
          <span>Bengaluru, and 135 cities where the work runs</span>
        </div>
      </div>
      <div class="masthead__lede">
        <p class="lede">Mobility is the mainstay: cycling, walking and public transport. Urban governance and policy support run through everything we do, from campaigning for active-mobility law to the dashboards a state government tracks its economy on.</p>
        <div class="masthead__actions">
          <a class="btn btn--dark" href="/projects/">See our work</a>
          <a class="btn btn--white" href="#contact">Talk to us</a>
        </div>
      </div>
    </section>

    <section class="section" id="ventures">
      <h2>What we build and back</h2>
      <div class="grid grid--3">
        {ventures.map((v) => (
          <article class="panel panel--white venture">
            <div class="venture__head"><h3>{v.name}</h3><span class="tag">{v.status}</span></div>
            <p>{v.description}</p>
            {v.url ? <a href={v.url} target={v.url.startsWith('http') ? '_blank' : undefined} rel="noopener">{v.host}</a> : <span class="muted">{v.host}</span>}
          </article>
        ))}
      </div>
    </section>

    <section class="section" id="work">
      <h2>What we do</h2>
      <div class="grid grid--3">
        {focus.map((f, i) => (
          <article class:list={['panel', strandClass[i], 'strand', i === 2 ? 'on-dark' : '']}>
            <h3>{f.name}</h3>
            <p>{f.description}</p>
            <ul class="links">
              {f.links.map((l) => <li><a href={l.href} target={l.href.startsWith('http') ? '_blank' : undefined} rel="noopener">{l.label}</a></li>)}
            </ul>
          </article>
        ))}
      </div>
    </section>

    <section class="section" aria-label="Outcomes">
      <ul class="grid grid--4 outcomes">
        {outcomes.map((o) => (
          <li class="stat"><b>{o.value.replace('1st', 'First')}</b><span>{o.label}</span><small>{o.detail}</small></li>
        ))}
      </ul>
    </section>

    <section class="section" id="partners-say">
      <h2>What partners say</h2>
      <div class="grid grid--3">
        {testimonials.map((t) => {
          const logo = img(t.logo);
          return (
            <figure class="panel panel--white quote">
              <blockquote><p>{t.quote}</p></blockquote>
              <figcaption>
                {logo && <Image src={logo} alt="" width={200} height={Math.round((200 * logo.height) / logo.width)} quality={75} loading="lazy" />}
                <span>{t.author}</span>
              </figcaption>
            </figure>
          );
        })}
      </div>
    </section>

    <section class="section" id="street">
      <div class="section__head"><h2>From the street</h2><a href="/projects/">All {projects.length} projects</a></div>
      <div class="grid grid--3">
        {street.map((p) => {
          const image = img(p.image);
          return (
            <article class="card">
              <div class="card__media">{image && <Image src={image} alt={p.alt || p.title} widths={[400, 640, 900]} sizes="(max-width: 620px) 100vw, 33vw" quality={65} loading="lazy" />}</div>
              <div class="card__body"><h3>{p.title}</h3><p>{p.description}</p></div>
            </article>
          );
        })}
      </div>
    </section>

    <section class="panel panel--white recognition" id="recognition">
      <div class="recognition__col">
        <h2>Awards</h2>
        <ul class="awards">
          {awards.map((a) => (
            <li><b>{a.year}</b><div><h3>{a.title}</h3><p>{a.description}</p></div></li>
          ))}
        </ul>
      </div>
      <div class="recognition__col">
        <h2>Partners</h2>
        <div class="partners">
          {partners.map((group) => (
            <div class="partners__group">
              <h3>{group.category}</h3>
              <ul>
                {group.items.map((pt) => {
                  const logo = img(pt.logo);
                  return <li>{logo && <Image src={logo} alt="" width={160} height={Math.round((160 * logo.height) / logo.width)} quality={75} loading="lazy" />}<span>{pt.name}</span></li>;
                })}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="panel panel--asphalt on-dark crew" id="crew">
      <div class="section__head"><h2>The crew</h2><a href="/people/">Profiles</a></div>
      <div class="roster">
        {team.map((m) => {
          const photo = img(m.photo);
          return (
            <a class="roster__row" href={`/people/${m.slug}/`}>
              {photo && <Image src={photo} alt="" width={112} height={112} quality={70} loading="lazy" />}
              <b>{m.name}</b><em>{m.role}</em><span>{m.line}</span>
            </a>
          );
        })}
      </div>
    </section>

    <section class="board on-yellow contact" id="contact">
      <div>
        <h2>Talk to us</h2>
        <p class="contact__text">For governments, philanthropies and partners. Write to <a href={`mailto:${site.email}`}>{site.email}</a>, or find us at <a href={site.mapsUrl} target="_blank" rel="noopener">41 Vishnu Nivas, NGEF Colony, Sanjaynagar, Bengaluru 560094</a>.</p>
      </div>
      <a class="btn btn--dark" href={`mailto:${site.email}`}>Write to us</a>
    </section>

  </div>
</Base>

<style>
  .masthead { display: flex; flex-direction: column; }
  .masthead__board { border-radius: var(--radius) var(--radius) 0 0; padding: clamp(24px, 3.5vw, 48px); display: grid; grid-template-columns: minmax(0, 1fr) 300px; gap: 40px; align-items: end; }
  .masthead__text { display: flex; flex-direction: column; gap: 22px; }
  .masthead__kicker { font-size: clamp(1.25rem, 2.2vw, 1.75rem); font-weight: 600; line-height: 1.3; display: flex; flex-wrap: wrap; align-items: baseline; gap: 0 0.2em; }
  .masthead__slash { font-weight: 400; }
  .masthead h1 { max-width: 12ch; }
  .masthead__aside { display: flex; flex-direction: column; gap: 6px; font-size: 1rem; line-height: 1.45; border-left: 3px solid var(--asphalt); padding-left: 18px; }
  .masthead__lede { background: var(--white); border: 6px solid var(--asphalt); border-top: 0; border-radius: 0 0 var(--radius) var(--radius); padding: clamp(20px, 2.5vw, 30px) clamp(24px, 3.5vw, 48px); display: flex; justify-content: space-between; align-items: center; gap: 32px; }
  .masthead__actions { display: flex; gap: 12px; flex: none; flex-wrap: wrap; }
  .venture { padding: 26px 28px 28px; display: flex; flex-direction: column; gap: 10px; }
  .venture__head { display: flex; justify-content: space-between; align-items: center; gap: 12px; }
  .venture h3 { font-size: 1.8rem; }
  .venture p { flex: 1; }
  .strand { padding: 32px 30px 30px; display: flex; flex-direction: column; gap: 14px; }
  .strand h3 { font-size: clamp(1.8rem, 2.6vw, 2.5rem); font-stretch: 90%; }
  .strand p { flex: 1; }
  .outcomes { list-style: none; margin: 0; padding: 0; }
  .crew { padding: clamp(24px, 3vw, 40px); display: flex; flex-direction: column; gap: 20px; }
  .contact { padding: clamp(24px, 3vw, 44px); display: flex; justify-content: space-between; align-items: center; gap: 32px; }
  .contact__text { margin-top: 10px; max-width: 60ch; font-size: 1.1rem; }
  .contact a:not(.btn) { color: var(--asphalt); }
  .quote { margin: 0; padding: 26px 28px 28px; display: flex; flex-direction: column; gap: 18px; }
  .quote blockquote { margin: 0; flex: 1; }
  .quote blockquote p { font-size: 1.2rem; line-height: 1.4; }
  .quote figcaption { display: flex; align-items: center; gap: 14px; padding-top: 14px; border-top: 1px solid var(--rule); }
  .quote figcaption img { max-height: 36px; width: auto; max-width: 120px; object-fit: contain; }
  .quote figcaption span { font-weight: 600; font-size: 0.95rem; }
  .recognition { padding: clamp(24px, 3vw, 40px); display: grid; grid-template-columns: 1fr 1.4fr; gap: 40px; }
  .recognition__col { display: flex; flex-direction: column; gap: 16px; }
  .awards { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; }
  .awards li { display: grid; grid-template-columns: 64px minmax(0, 1fr); gap: 12px; padding: 14px 0; border-top: 1px solid var(--rule); }
  .awards li:last-child { border-bottom: 1px solid var(--rule); }
  .awards b { font-size: 1.1rem; }
  .awards h3 { font-size: 1.15rem; }
  .awards p { font-size: 0.95rem; color: var(--muted); margin-top: 2px; }
  .partners { display: flex; flex-direction: column; gap: 18px; }
  .partners__group h3 { font-size: 0.95rem; font-weight: 600; color: var(--muted); margin-bottom: 8px; }
  .partners__group ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .partners__group li { display: flex; align-items: center; gap: 10px; border: 1px solid var(--rule); border-radius: 4px; padding: 8px 12px; min-height: 56px; background: var(--white); }
  .partners__group img { max-height: 32px; width: auto; max-width: 96px; object-fit: contain; }
  .partners__group span { font-size: 0.9rem; font-weight: 600; }
  @media (max-width: 991px) {
    .recognition { grid-template-columns: 1fr; }
    .masthead__board { grid-template-columns: 1fr; }
    .masthead__aside { border-left: 0; border-top: 3px solid var(--asphalt); padding: 14px 0 0; }
    .masthead__lede, .contact { flex-direction: column; align-items: flex-start; }
  }
</style>
