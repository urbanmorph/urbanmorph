---
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { img } from '../lib/images';
import data from '../data/synthesys.json';

const badgeClass: Record<string, string> = { 'fa-chart-line': 'tag--blue', 'fa-newspaper': 'tag--blue', 'fa-map-marked-alt': 'tag--green', 'fa-comments': 'tag--blue', 'fa-brain': 'tag--green', 'fa-recycle': 'tag--green', 'fa-landmark': 'tag--blue' };
const title = 'SyntheSYS';
const numberWord = ['No', 'One', 'Two', 'Three', 'Four', 'Five', 'Six', 'Seven', 'Eight', 'Nine', 'Ten', 'Eleven', 'Twelve', 'Thirteen', 'Fourteen', 'Fifteen'];
const storyCount = numberWord[data.stories.length] ?? String(data.stories.length);
const toolCount = numberWord[data.tools.length] ?? String(data.tools.length);
const description = `Urban Morph's AI-native urban services: live platforms for active mobility policy, Karnataka's digital economy and neighbourhood climate action, revived civic archives, ${toolCount.toLowerCase()} open tools and ${storyCount.toLowerCase()} data stories, from ward to nation.`;
const ogSrc = img('img/synthesys/kdem-screenshot.webp');
const ogImage = ogSrc ? (await getImage({ src: ogSrc, width: 1200, format: 'jpg' })).src : '/UM-thumbnail.png';
const jsonLd = [{ '@context': 'https://schema.org', '@type': 'SoftwareApplication', name: 'SyntheSYS', applicationCategory: 'BusinessApplication', operatingSystem: 'Web', description, url: 'https://www.urbanmorph.com/synthesys/', author: { '@type': 'Organization', name: 'Urban Morph', url: 'https://www.urbanmorph.com' }, offers: { '@type': 'Offer', availability: 'https://schema.org/InStock', price: '0', priceCurrency: 'INR' } }];
---

<Base title={title} description={description} jsonLd={jsonLd} image={ogImage}>
  <div class="container stack">
    <section class="panel panel--asphalt on-dark hero">
      <div class="hero__text">
        <h1>SyntheSYS</h1>
        <p class="lede">AI-native urban services. Live platforms, revived civic archives, open tools and data stories that orchestrate urban solutions from ward to nation.</p>
        <div class="hero__actions">
          <a class="btn btn--yellow" href="#platforms">The platforms</a>
          <a class="btn btn--light" href="/blog/synthesys-orchestrating-progress/">Read the origin story</a>
        </div>
      </div>
      <ul class="hero__stats">
        <li><b>{data.platforms.length}</b><span>live platforms</span></li>
        <li><b>{data.tools.length}</b><span>open tools</span></li>
        <li><b>{data.stories.length}</b><span>data stories</span></li>
        <li><b>1998</b><span>oldest archive</span></li>
      </ul>
    </section>

    <section class="section" id="platforms">
      <h2>The platforms</h2>
      <div class="platforms">
        {data.platforms.map((p, i) => {
          const image = img(p.image);
          return (
            <article class="platform">
              <div class="platform__media">{image && <Image src={image} alt={p.alt} widths={[560, 900, 1200]} sizes="(max-width: 900px) 100vw, 560px" quality={70} loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : undefined} />}</div>
              <div class="platform__body">
                <span class:list={['tag', badgeClass[p.icon] ?? 'tag--blue']}>{p.badge}</span>
                <h3>{p.name.replace(' — ', ', ')}</h3>
                <p>{p.description}</p>
                <ul class="platform__features">{p.features.map((f) => <li>{f}</li>)}</ul>
                <a href={p.url} target="_blank" rel="noopener">{p.url.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '')}</a>
              </div>
            </article>
          );
        })}
      </div>
    </section>

    <section class="panel panel--white tools" id="tools">
      <div class="section__head"><h2>{toolCount} open tools</h2><span class="muted">Free, no login, open source</span></div>
      <p class="tools__intro">Built by Urban Morph co-founder Sathya Sankaran. Most can also be queried from AI assistants over MCP.</p>
      <div class="tools__grid">
        {data.tools.map((t) => (
          <div class="tool">
            <h3>{t.name}</h3>
            <p>{t.description}</p>
            <a href={t.url} target="_blank" rel="noopener">{t.host}</a>
          </div>
        ))}
      </div>
    </section>

    <section class="section" id="stories">
      <div class="section__head"><h2>{storyCount} data stories</h2><span class="muted">Data-driven investigations into food, air, forests, farmers, livelihoods and rights</span></div>
      <div class="grid grid--3">
        {data.stories.map((s) => (
          <a class="panel panel--blue story" href={s.url} target="_blank" rel="noopener">
            <span class="story__tag">{s.tag.replace(/ · /g, ', ')}</span>
            <span class="story__title">{s.title}</span>
            <span class="story__teaser">{s.teaser}</span>
          </a>
        ))}
      </div>
    </section>

    <section class="board on-yellow cta">
      <div>
        <h2>Bring SyntheSYS to your district, city or state.</h2>
        <p class="cta__text">Write to us about dashboards, platforms, archives and data stories for your region.</p>
      </div>
      <a class="btn btn--dark" href="mailto:contact@urbanmorph.com">Get in touch</a>
    </section>
  </div>
</Base>

<style>
  .hero { padding: clamp(24px, 3.5vw, 48px); display: grid; grid-template-columns: 1.1fr 1fr; gap: 40px; align-items: end; }
  .hero__text { display: flex; flex-direction: column; gap: 18px; }
  .hero h1 { font-size: clamp(3rem, 7vw, 6rem); }
  .hero .lede { color: var(--paper); }
  .hero__actions { display: flex; flex-wrap: wrap; gap: 12px; }
  .hero__stats { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; }
  .hero__stats li { border: 3px solid var(--yellow); border-radius: var(--radius); padding: 16px 20px; display: flex; flex-direction: column; gap: 2px; }
  .hero__stats b { font-size: clamp(2.2rem, 3.5vw, 2.8rem); font-weight: 800; line-height: 1; font-stretch: 85%; color: var(--yellow); }
  .hero__stats span { font-weight: 600; }
  .platforms { display: flex; flex-direction: column; }
  .platform { display: grid; grid-template-columns: 560px minmax(0, 1fr); gap: 32px; align-items: center; padding: 24px 0; border-top: 1px solid var(--rule); }
  .platform:first-child { border-top: 2px solid var(--asphalt); }
  .platform__media img { border-radius: var(--radius); border: 3px solid var(--asphalt); display: block; }
  .platform__body { display: flex; flex-direction: column; gap: 12px; align-items: flex-start; }
  .platform h3 { font-size: clamp(1.5rem, 2.4vw, 2.1rem); font-stretch: 90%; }
  .platform__features { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 6px; font-size: 1rem; }
  .platform__features li { padding-left: 18px; position: relative; }
  .platform__features li::before { content: ''; position: absolute; left: 0; top: 0.55em; width: 8px; height: 8px; background: var(--asphalt); border-radius: 2px; }
  .tools { padding: clamp(24px, 3vw, 36px); display: flex; flex-direction: column; gap: 16px; }
  .tools__intro { max-width: 70ch; }
  .tools__grid { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 24px; margin-top: 8px; }
  .tool { display: flex; flex-direction: column; gap: 6px; border-top: 2px solid var(--asphalt); padding-top: 12px; }
  .tool h3 { font-size: 1.35rem; }
  .tool p { font-size: 0.95rem; line-height: 1.45; flex: 1; }
  .story { padding: 26px 24px; display: flex; flex-direction: column; gap: 10px; min-height: 220px; text-decoration: none; font-weight: 400; }
  .story:hover .story__title { text-decoration: underline; }
  .story__tag { font-size: 0.9rem; font-weight: 600; opacity: 0.9; }
  .story__title { font-size: 1.6rem; font-weight: 700; line-height: 1.1; }
  .story__teaser { font-size: 1rem; line-height: 1.45; }
  .cta { padding: clamp(24px, 3vw, 40px); display: flex; justify-content: space-between; align-items: center; gap: 32px; }
  .cta__text { margin-top: 8px; font-size: 1.1rem; }
  @media (max-width: 991px) { .hero { grid-template-columns: 1fr; } .platform { grid-template-columns: 1fr; gap: 16px; } .tools__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } .cta { flex-direction: column; align-items: flex-start; } }
  @media (max-width: 620px) { .tools__grid { grid-template-columns: 1fr; } .hero__stats { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
</style>
