---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { img } from '../lib/images';

interface Member {
  name: string;
  role: string;
  photo: string;
  links: { type: string; url: string }[];
  bio: string;
  details: string;
}
interface Props { member: Member; compact?: boolean }
const { member, compact = false } = Astro.props;
const photo = img(member.photo);
const iconFor: Record<string, { icon: string; label: string }> = {
  linkedin: { icon: 'simple-icons:linkedin', label: 'LinkedIn' },
  x: { icon: 'simple-icons:x', label: 'X' },
  email: { icon: 'tabler:mail', label: 'Email' },
  website: { icon: 'tabler:world', label: 'Website' },
  rss: { icon: 'tabler:rss', label: 'Blog' },
  wikipedia: { icon: 'simple-icons:wikipedia', label: 'Wikipedia' },
  instagram: { icon: 'simple-icons:instagram', label: 'Instagram' },
  youtube: { icon: 'simple-icons:youtube', label: 'YouTube' },
};
---

<article class:list={['team-card', { 'team-card--compact': compact }]}>
  <div class="team-card__photo">
    {photo && <Image src={photo} alt="" widths={compact ? [120, 240] : [320, 480, 640]} sizes={compact ? '96px' : '(max-width: 600px) 100vw, 33vw'} loading="lazy" />}
  </div>
  <div class="team-card__body">
    <h3>{member.name}</h3>
    <p class="team-card__role">{member.role}</p>
    <div class="team-card__bio" set:html={member.bio} />
    {member.details && !compact && (
      <details class="team-card__more">
        <summary><Icon name="tabler:chevron-down" size={16} /> Know more</summary>
        <div class="team-card__details" set:html={member.details} />
      </details>
    )}
    {member.links.length > 0 && (
      <ul class="team-card__links" aria-label={`${member.name} links`}>
        {member.links.map((l) => {
          const m = iconFor[l.type] ?? iconFor.website;
          return <li><a href={l.url} target={l.url.startsWith('mailto:') ? undefined : '_blank'} rel="noopener" aria-label={`${member.name} on ${m.label}`}><Icon name={m.icon} size={16} /></a></li>;
        })}
      </ul>
    )}
  </div>
</article>

<style>
  .team-card { background: var(--white); border: 1px solid var(--rule); border-radius: var(--radius); overflow: hidden; display: flex; flex-direction: column; height: 100%; }
  .team-card__photo { aspect-ratio: 1 / 1; background: var(--teal-soft); overflow: hidden; }
  .team-card__photo img { width: 100%; height: 100%; object-fit: cover; object-position: center 20%; display: block; }
  .team-card__body { padding: 1.4rem 1.5rem 1.5rem; display: flex; flex-direction: column; gap: 0.5rem; flex: 1; }
  .team-card h3 { font-size: 1.3rem; }
  .team-card__role { font-family: var(--font-mono); font-size: var(--text-xs); letter-spacing: 0.12em; text-transform: uppercase; color: var(--teal); font-weight: 700; }
  .team-card__bio { color: var(--gray); font-size: var(--text-sm); line-height: 1.65; }
  .team-card__bio :global(a) { font-weight: 700; text-decoration: none; }
  .team-card__more summary { cursor: pointer; list-style: none; display: inline-flex; align-items: center; gap: 0.35rem; min-height: 36px; color: var(--teal-ink); font-family: var(--font-mono); font-size: var(--text-xs); letter-spacing: 0.08em; text-transform: uppercase; }
  .team-card__more summary::-webkit-details-marker { display: none; }
  .team-card__more[open] summary :global(svg) { transform: rotate(180deg); }
  .team-card__details { font-size: var(--text-sm); color: var(--gray); line-height: 1.65; padding-top: 0.5rem; }
  .team-card__details :global(p + p) { margin-top: 0.8em; }
  .team-card__details :global(a) { font-weight: 700; text-decoration: none; }
  .team-card__links { list-style: none; margin: auto 0 0; padding: 0.5rem 0 0; display: flex; gap: 0.35rem; }
  .team-card__links a { display: inline-flex; align-items: center; justify-content: center; width: var(--tap); height: var(--tap); border-radius: 50%; background: var(--paper); color: var(--ink-2); border: 1px solid var(--rule); }
  .team-card__links a:hover { background: var(--teal); border-color: var(--teal); color: #fff; }
  .team-card--compact { flex-direction: row; align-items: flex-start; }
  .team-card--compact .team-card__photo { flex: none; width: 96px; height: 96px; aspect-ratio: 1; margin: 1.25rem 0 1.25rem 1.25rem; border-radius: 50%; }
  .team-card--compact .team-card__body { padding: 1.25rem; }
  .team-card--compact h3 { font-size: 1.1rem; }
  @media (max-width: 480px) { .team-card--compact { flex-direction: column; } .team-card--compact .team-card__photo { margin: 1.25rem 1.25rem 0; } }
</style>
