---
/**
 * Inline SVG icon from the Iconify JSON sets, rendered at build time.
 * name: "tabler:bike" or "simple-icons:linkedin"
 */
import { icons as tabler } from '@iconify-json/tabler';
import { icons as simple } from '@iconify-json/simple-icons';

interface Props {
  name: string;
  size?: number | string;
  class?: string;
  label?: string;
}
const { name, size = 20, class: cls, label } = Astro.props;
const [set, id] = name.split(':');
const src = set === 'simple-icons' ? simple : tabler;
const icon = (src.icons as Record<string, { body: string; width?: number; height?: number }>)[id];
if (!icon) throw new Error(`Unknown icon: ${name}`);
const w = icon.width ?? src.width ?? 24;
const h = icon.height ?? src.height ?? 24;
---

<svg
  width={size}
  height={size}
  viewBox={`0 0 ${w} ${h}`}
  class:list={['icon', cls]}
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
  focusable="false"
  set:html={icon.body}
/>

<style>
  .icon {
    display: inline-block;
    vertical-align: -0.15em;
    flex: none;
  }
</style>
