---
import Icon from './Icon.astro';
import { site } from '../lib/site';
const year = new Date().getFullYear();
const socialIcon: Record<string, string> = { linkedin: 'simple-icons:linkedin', x: 'simple-icons:x', instagram: 'simple-icons:instagram' };
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div>
      <h2 class="footer-title">Urban Morph</h2>
      <p>Shaping the future of cities through innovation, collaboration and execution in sustainable urban mobility and infrastructure.</p>
      <ul class="social">
        {site.social.map((s) => (
          <li><a href={s.url} target="_blank" rel="noopener" aria-label={s.label}><Icon name={socialIcon[s.type]} size={18} /></a></li>
        ))}
      </ul>
    </div>
    <div>
      <h2 class="footer-title">Quick links</h2>
      <ul class="links">
        <li><a href="/">Home</a></li>
        <li><a href="/projects/">Projects</a></li>
        <li><a href="/media/">Media coverage</a></li>
        <li><a href="/blog/">Blog</a></li>
        <li><a href="/#contact">Contact us</a></li>
      </ul>
    </div>
    <div>
      <h2 class="footer-title">Our solutions</h2>
      <ul class="links">
        <li><a href="https://www.altmo.app" target="_blank" rel="noopener">AltMo</a></li>
        <li><a href="/synthesys/">SyntheSYS</a></li>
        <li><a href="https://podcast.oorulabs.com" target="_blank" rel="noopener">OoruLabs</a></li>
      </ul>
    </div>
    <div>
      <h2 class="footer-title">Contact</h2>
      <ul class="links">
        <li><a href={`mailto:${site.email}`}><Icon name="tabler:mail" size={16} /> {site.email}</a></li>
        <li><a href={site.mapsUrl} target="_blank" rel="noopener"><Icon name="tabler:map-pin" size={16} /> Bengaluru, Karnataka, India</a></li>
      </ul>
    </div>
  </div>
  <div class="container copyright">
    <p>© {year} {site.legalName}. All rights reserved.</p>
  </div>
</footer>

<style>
  .site-footer { background: var(--ink-2); color: rgba(255,255,255,0.8); padding-block: 3.5rem 1.5rem; margin-top: auto; }
  .footer-grid { display: grid; grid-template-columns: 1.4fr 1fr 1fr 1.2fr; gap: 2rem; }
  .footer-title { font-family: var(--font-mono); font-size: var(--text-xs); letter-spacing: 0.18em; text-transform: uppercase; color: var(--yellow); margin-bottom: 1rem; font-weight: 700; }
  .site-footer p { font-size: var(--text-sm); }
  .links, .social { list-style: none; margin: 0; padding: 0; }
  .links li { margin-bottom: 0.15rem; }
  .links a { color: rgba(255,255,255,0.85); text-decoration: none; font-size: var(--text-sm); display: inline-flex; align-items: center; gap: 0.4rem; min-height: 36px; }
  .links a:hover { color: var(--yellow); }
  .social { display: flex; gap: 0.5rem; margin-top: 1.25rem; }
  .social a { display: inline-flex; align-items: center; justify-content: center; width: var(--tap); height: var(--tap); border-radius: 50%; background: rgba(255,255,255,0.1); color: #fff; }
  .social a:hover { background: var(--teal); }
  .copyright { border-top: 1px solid rgba(255,255,255,0.12); margin-top: 2.5rem; padding-top: 1.25rem; text-align: center; }
  .copyright p { font-family: var(--font-mono); font-size: var(--text-xs); color: rgba(255,255,255,0.55); }
  @media (max-width: 900px) { .footer-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 520px) { .footer-grid { grid-template-columns: 1fr; } }
</style>
