---
import Icon from './Icon.astro';
import { site } from '../lib/site';
const year = new Date().getFullYear();
const socialIcon: Record<string, string> = { linkedin: 'simple-icons:linkedin', x: 'simple-icons:x', instagram: 'simple-icons:instagram' };
---

<footer class="site-footer on-dark">
  <div class="container footer-grid">
    <div class="footer-col">
      <span class="footer-brand">Urban Morph</span>
      <p>An AI-native, full-stack policy and urban-tech venture studio, Bengaluru.</p>
      <ul class="social">
        {site.social.map((s) => (
          <li><a href={s.url} target="_blank" rel="noopener" aria-label={s.label}><Icon name={socialIcon[s.type]} size={18} /></a></li>
        ))}
      </ul>
      <p class="small">© {year} {site.legalName}</p>
    </div>
    <div class="footer-col">
      <span class="footer-title">Site</span>
      <a href="/synthesys/">SyntheSYS</a><a href="/projects/">Projects</a><a href="/media/">Media</a><a href="/blog/">Blog</a><a href="/people/">People</a>
    </div>
    <div class="footer-col">
      <span class="footer-title">Ventures</span>
      <a href="https://www.altmo.app" target="_blank" rel="noopener">AltMo</a><a href="https://saralcare.com" target="_blank" rel="noopener">SaralCare</a><a href="https://podcast.oorulabs.com" target="_blank" rel="noopener">OoruLabs</a>
    </div>
    <div class="footer-col">
      <span class="footer-title">Contact</span>
      <a href={`mailto:${site.email}`}>{site.email}</a>
      <a href={site.mapsUrl} target="_blank" rel="noopener">41 Vishnu Nivas, NGEF Colony, Sanjaynagar, Bengaluru 560094</a>
    </div>
  </div>
</footer>

<style>
  .site-footer { background: var(--asphalt); color: var(--muted-dark); padding-block: 40px 44px; margin-top: auto; font-size: 0.95rem; line-height: 1.6; }
  .footer-grid { display: grid; grid-template-columns: 1.4fr 1fr 1fr 1.2fr; gap: 32px; }
  .footer-col { display: flex; flex-direction: column; gap: 4px; align-items: flex-start; }
  .footer-brand { color: var(--paper); font-weight: 700; font-size: 1.3rem; margin-bottom: 4px; }
  .footer-title { color: var(--paper); font-weight: 700; margin-bottom: 4px; }
  .site-footer a { color: var(--muted-dark); text-decoration: none; font-weight: 400; min-height: 32px; display: inline-flex; align-items: center; }
  .site-footer a:hover { color: var(--yellow); }
  .social { list-style: none; margin: 12px 0 8px; padding: 0; display: flex; gap: 8px; }
  .social a { width: var(--tap); height: var(--tap); border-radius: 4px; border: 1px solid var(--rule-dark); justify-content: center; color: var(--paper); }
  .social a:hover { background: var(--yellow); color: var(--asphalt); }
  @media (max-width: 900px) { .footer-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 520px) { .footer-grid { grid-template-columns: 1fr; } }
</style>
