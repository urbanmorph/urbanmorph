---
import { Image } from 'astro:assets';
import { formatDate, slugify, type Post } from '../lib/blog';

interface Props { post: Post; featured?: boolean }
const { post, featured = false } = Astro.props;
const { title, description, date, category, hero, heroUrl, thumb } = post.data;
const pic = hero ?? thumb;
const href = `/blog/${post.id}/`;
---

<article class:list={['card', 'post-card', { 'post-card--featured': featured }]}>
  <a class="card__media post-card__media" href={href} tabindex="-1" aria-hidden="true">
    {pic ? (
      <Image src={pic} alt="" widths={featured ? [480, 800, 1200] : [320, 480, 640]} sizes={featured ? '(max-width: 900px) 100vw, 60vw' : '(max-width: 620px) 100vw, 33vw'} loading={featured ? 'eager' : 'lazy'} quality={65} />
    ) : heroUrl ? (
      <img src={heroUrl} alt="" loading="lazy" />
    ) : (
      <div class="post-card__block"><span>{category}</span></div>
    )}
  </a>
  <div class="card__body">
    <p class="card__kind"><a class="post-card__cat" href={`/blog/category/${slugify(category)}/`}>{category}</a>, <time datetime={date.toISOString()}>{formatDate(date)}</time></p>
    <h3><a href={href}>{title}</a></h3>
    {description && <p>{description}</p>}
  </div>
</article>

<style>
  .post-card__block { width: 100%; height: 100%; display: flex; align-items: flex-end; padding: 16px 20px; background: var(--blue); color: var(--white); font-weight: 600; font-size: 0.95rem; }
  .post-card__cat { color: var(--blue); text-decoration: none; }
  .post-card__cat:hover { text-decoration: underline; }
  .post-card h3 a { color: var(--asphalt); text-decoration: none; }
  .post-card h3 a:hover { text-decoration: underline; }
  .post-card p:not(.card__kind) { display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .post-card--featured { display: grid; grid-template-columns: 1.3fr 1fr; }
  .post-card--featured .post-card__media { aspect-ratio: auto; min-height: 320px; border-bottom: 0; border-right: 2px solid var(--asphalt); }
  .post-card--featured .card__body { padding: 32px; justify-content: center; }
  .post-card--featured h3 { font-size: clamp(1.8rem, 3vw, 2.6rem); font-weight: 800; font-stretch: 85%; letter-spacing: -0.01em; }
  .post-card--featured p:not(.card__kind) { -webkit-line-clamp: 4; font-size: 1.1rem; }
  @media (max-width: 900px) { .post-card--featured { grid-template-columns: 1fr; } .post-card--featured .post-card__media { aspect-ratio: 16 / 9; min-height: 0; border-right: 0; border-bottom: 2px solid var(--asphalt); } }
</style>
