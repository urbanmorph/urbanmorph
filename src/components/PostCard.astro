---
import { Image } from 'astro:assets';
import { formatDate, slugify, type Post } from '../lib/blog';

interface Props {
  post: Post;
  featured?: boolean;
}
const { post, featured = false } = Astro.props;
const { title, description, date, category, hero, heroUrl, thumb } = post.data;
const pic = hero ?? thumb;
const href = `/blog/${post.id}/`;
---

<article class:list={['post-card', { 'post-card--featured': featured }]}>
  <a class="post-card__media" href={href} tabindex="-1" aria-hidden="true">
    {pic ? (
      <Image src={pic} alt="" widths={featured ? [480, 800, 1200] : [320, 480, 640]} sizes={featured ? '(max-width: 900px) 100vw, 60vw' : '(max-width: 600px) 100vw, 33vw'} loading={featured ? 'eager' : 'lazy'} quality={65} />
    ) : heroUrl ? (
      <img src={heroUrl} alt="" loading="lazy" />
    ) : (
      <div class="post-card__placeholder"><span>{category}</span></div>
    )}
  </a>
  <div class="post-card__body">
    <div class="post-card__meta">
      <a class="chip chip--soft" href={`/blog/category/${slugify(category)}/`}>{category}</a>
      <time class="meta" datetime={date.toISOString()}>{formatDate(date)}</time>
    </div>
    <h3><a href={href}>{title}</a></h3>
    {description && <p>{description}</p>}
  </div>
</article>

<style>
  .post-card { display: flex; flex-direction: column; background: var(--white); border: 1px solid var(--rule); border-radius: var(--radius); overflow: hidden; height: 100%; }
  .post-card__media { display: block; aspect-ratio: 16 / 9; background: var(--teal-soft); overflow: hidden; }
  .post-card__media img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .post-card__placeholder { width: 100%; height: 100%; display: flex; align-items: flex-end; padding: 1rem; background: linear-gradient(135deg, var(--teal), var(--green)); color: rgba(255,255,255,0.85); font-family: var(--font-mono); font-size: var(--text-xs); letter-spacing: 0.14em; text-transform: uppercase; }
  .post-card__body { padding: 1.25rem 1.4rem 1.5rem; display: flex; flex-direction: column; gap: 0.6rem; }
  .post-card__meta { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 0.9rem; }
  .post-card h3 { font-size: 1.25rem; line-height: 1.25; }
  .post-card h3 a { color: var(--ink-2); text-decoration: none; }
  .post-card h3 a:hover { color: var(--teal); text-decoration: underline; }
  .post-card p { color: var(--gray); font-size: var(--text-sm); line-height: 1.6; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .post-card--featured { display: grid; grid-template-columns: 1.3fr 1fr; }
  .post-card--featured .post-card__media { aspect-ratio: auto; min-height: 320px; }
  .post-card--featured .post-card__body { padding: 2rem; justify-content: center; }
  .post-card--featured h3 { font-size: var(--text-2xl); font-weight: 900; }
  .post-card--featured p { -webkit-line-clamp: 4; font-size: var(--text-base); }
  @media (max-width: 900px) { .post-card--featured { grid-template-columns: 1fr; } .post-card--featured .post-card__media { aspect-ratio: 16 / 9; min-height: 0; } }
</style>
