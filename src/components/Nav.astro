---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import mark from '../assets/img/um-mark.png';
import { site } from '../lib/site';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => {
  const h = href.replace(/\/$/, '') || '/';
  if (h.startsWith('/#')) return false;
  return path === h || path.startsWith(h + '/');
};
---

<header class="site-header on-dark">
  <a class="skip-link" href="#main">Skip to content</a>
  <nav class="nav container" aria-label="Main">
    <a class="brand" href="/"><Image src={mark} alt="" width={64} height={Math.round(64 * mark.height / mark.width)} loading="eager" /><span>Urban Morph</span></a>
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="nav-menu">
      <Icon name="tabler:menu-2" size={26} />
      <span class="visually-hidden">Menu</span>
    </button>
    <ul id="nav-menu" class="nav-menu">
      {site.nav.map((item) => (
        <li><a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a></li>
      ))}
    </ul>
  </nav>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.nav-toggle');
  const menu = document.getElementById('nav-menu');
  btn?.addEventListener('click', () => {
    const open = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!open));
    menu?.classList.toggle('is-open', !open);
  });
</script>

<style>
  .site-header { background: var(--asphalt); color: var(--paper); }
  .nav { display: flex; align-items: center; justify-content: space-between; gap: 1rem; min-height: 68px; }
  .brand { color: var(--paper); text-decoration: none; font-weight: 700; font-size: 1.5rem; min-height: var(--tap); display: inline-flex; align-items: center; gap: 12px; }
  .brand img { width: 32px; height: auto; display: block; }
  .brand:hover { color: var(--yellow); }
  .nav-toggle { display: none; background: transparent; color: var(--paper); border: 2px solid var(--rule-dark); border-radius: 4px; width: var(--tap); height: var(--tap); align-items: center; justify-content: center; cursor: pointer; }
  .nav-menu { list-style: none; margin: 0; padding: 0; display: flex; gap: 0.25rem; }
  .nav-menu a { display: inline-flex; align-items: center; min-height: var(--tap); padding: 0 0.9rem; color: var(--paper); text-decoration: none; font-weight: 500; font-size: 1.05rem; }
  .nav-menu a:hover { color: var(--yellow); }
  .nav-menu a[aria-current="page"] { color: var(--yellow); font-weight: 700; }
  @media (max-width: 860px) {
    .nav { flex-wrap: wrap; }
    .nav-toggle { display: inline-flex; }
    .nav-menu { display: none; width: 100%; flex-direction: column; padding-block: 0.5rem 1rem; border-top: 1px solid var(--rule-dark); }
    .nav-menu.is-open { display: flex; }
    .nav-menu a { width: 100%; padding: 0 0.25rem; }
  }
</style>
