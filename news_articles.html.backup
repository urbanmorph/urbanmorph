  <style>
    :root {
      --um-yellow: #FBC831;
      --um-pink: #F7A782;
      --um-teal: #23A2A5;
      --um-green: #0D7576;
      --um-dark: #1a1a1a;
      --um-gray: #4a4a4a;
      --um-light: #FAF9F6;
      --newspaper-border: #2C2C2C;
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'PT Serif', 'Georgia', 'Times New Roman', serif;
      color: var(--um-dark);
      line-height: 1.8;
      overflow-x: hidden;
      background: var(--um-light);
    }

    /* Navigation */
    .navbar {
      background: var(--newspaper-border) !important;
      padding: 1rem 0;
      border-bottom: 4px double #000;
    }

    .navbar-brand {
      font-weight: 700;
      font-size: 1.3rem;
      letter-spacing: -0.5px;
      font-family: 'Playfair Display', serif;
    }

    .navbar-brand img {
      border-radius: 4px;
    }

    .nav-link {
      font-weight: 500;
      transition: all 0.3s ease;
      position: relative;
      padding: 0.5rem 1rem !important;
      font-family: 'PT Serif', serif;
      text-transform: uppercase;
      font-size: 0.85rem;
      letter-spacing: 1px;
    }

    .nav-link::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 50%;
      width: 0;
      height: 2px;
      background: var(--um-yellow);
      transition: all 0.3s ease;
      transform: translateX(-50%);
    }

    .nav-link:hover::after,
    .nav-link.active::after {
      width: 60%;
    }

    /* Newspaper Masthead */
    .newspaper-masthead {
      background: white;
      border-top: 3px double #000;
      border-bottom: 3px double #000;
      padding: 2.5rem 0 1.5rem;
      text-align: center;
      margin-bottom: 0;
    }

    .masthead-title {
      font-family: 'Playfair Display', serif;
      font-size: clamp(2.5rem, 6vw, 4.5rem);
      font-weight: 900;
      color: var(--newspaper-border);
      margin-bottom: 0.5rem;
      letter-spacing: 3px;
      text-transform: uppercase;
    }

    .masthead-subtitle {
      font-size: 0.85rem;
      color: #666;
      text-transform: uppercase;
      letter-spacing: 2px;
      font-weight: 400;
      border-top: 1px solid #ccc;
      border-bottom: 1px solid #ccc;
      padding: 0.5rem 0;
      display: inline-block;
      margin-top: 0.75rem;
      font-family: 'PT Serif', serif;
    }

    .edition-info {
      display: flex;
      justify-content: space-between;
      font-size: 0.7rem;
      color: #999;
      text-transform: uppercase;
      letter-spacing: 1px;
      margin-top: 1rem;
      padding: 0.5rem 0;
      border-top: 1px solid #ddd;
      font-family: 'Space Mono', monospace;
    }

    /* Content Section */
    .media-content {
      background: white;
      padding: 3rem 0 4rem;
      border-bottom: 3px double #000;
    }

    /* Section Headers - Newspaper Style */
    .section-header {
      border-top: 3px solid #000;
      border-bottom: 1px solid #000;
      padding: 0.75rem 0;
      margin: 3rem 0 2rem;
      font-family: 'Playfair Display', serif;
      font-weight: 900;
      font-size: 1.4rem;
      text-transform: uppercase;
      letter-spacing: 2px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .section-header:first-child {
      margin-top: 0;
    }

    .section-count {
      font-size: 0.75rem;
      font-weight: 400;
      color: #666;
      letter-spacing: 1px;
      font-family: 'Space Mono', monospace;
    }

    /* Newspaper Column Layout */
    .newspaper-columns {
      column-count: 2;
      column-gap: 4rem;
      column-rule: 1px solid #ddd;
    }

    @media (max-width: 992px) {
      .newspaper-columns {
        column-count: 1;
        column-rule: none;
      }
    }

    /* Article Cards - Newspaper Style */
    .article {
      break-inside: avoid;
      margin-bottom: 2.5rem;
      padding-bottom: 2rem;
      border-bottom: 2px solid #e5e5e5;
    }

    .article:last-child {
      border-bottom: none;
    }

    /* Category badges - Newspaper kickers */
    .award-badge {
      display: inline-block;
      padding: 0.3rem 0.85rem;
      font-size: 0.65rem;
      font-weight: 700;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      margin-bottom: 0.75rem;
      font-family: 'Space Mono', monospace;
      border: 2px solid;
    }

    .badge-milestone {
      background: white;
      color: var(--um-pink);
      border-color: var(--um-pink);
    }

    .badge-award {
      background: white;
      color: var(--um-green);
      border-color: var(--um-green);
    }

    .badge-product {
      background: white;
      color: #D4AF37;
      border-color: #D4AF37;
    }

    .badge-program {
      background: white;
      color: var(--um-teal);
      border-color: var(--um-teal);
    }

    /* Newspaper Headlines */
    .article-title {
      font-family: 'Playfair Display', serif;
      font-size: 1.5rem;
      font-weight: 700;
      color: var(--newspaper-border);
      margin-bottom: 0.75rem;
      line-height: 1.25;
    }

    .article-title a {
      color: var(--newspaper-border);
      text-decoration: none;
      transition: color 0.3s ease;
    }

    .article-title a:hover {
      color: var(--um-teal);
    }

    /* Article body text */
    .article-summary {
      color: #333;
      margin-bottom: 1rem;
      line-height: 1.8;
      font-size: 0.95rem;
      text-align: justify;
      hyphens: auto;
    }

    /* First paragraph drop cap for featured articles */
    .article.featured .article-summary::first-letter {
      float: left;
      font-size: 3.5rem;
      line-height: 0.9;
      margin: 0.1rem 0.15rem 0 0;
      font-weight: 700;
      font-family: 'Playfair Display', serif;
      color: var(--um-teal);
    }

    /* Newspaper byline/metadata */
    .article-meta {
      font-size: 0.8rem;
      color: #666;
      padding-top: 0.75rem;
      border-top: 1px solid #e9ecef;
      font-family: 'Space Mono', monospace;
    }

    .source {
      display: inline-block;
      font-weight: 700;
      color: var(--newspaper-border);
      font-style: italic;
      margin-right: 0.5rem;
      font-family: 'PT Serif', serif;
    }

    .article-meta small {
      line-height: 1.7;
      display: block;
      margin-top: 0.35rem;
      font-family: 'PT Serif', serif;
    }

    .article-meta small a {
      color: var(--um-teal);
      text-decoration: none;
      font-weight: 500;
    }

    .article-meta small a:hover {
      text-decoration: underline;
    }

    /* Ornamental dividers */
    .ornamental-divider {
      text-align: center;
      margin: 3rem 0;
      color: #999;
      font-size: 0.9rem;
    }

    .ornamental-divider::before {
      content: "❖ ❖ ❖";
      letter-spacing: 1.5rem;
    }

    /* Footer */
    footer {
      background: var(--newspaper-border);
      color: white;
      padding: 3rem 0 1.5rem;
      border-top: 3px double #000;
    }

    .footer-content {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 2.5rem;
      margin-bottom: 2rem;
    }

    .footer-section h5 {
      font-weight: 700;
      margin-bottom: 1.25rem;
      color: var(--um-yellow);
      font-size: 1.1rem;
      font-family: 'Playfair Display', serif;
      text-transform: uppercase;
      letter-spacing: 1px;
    }

    .footer-section ul {
      list-style: none;
      padding: 0;
    }

    .footer-section ul li {
      margin-bottom: 0.6rem;
    }

    .footer-section a {
      color: rgba(255, 255, 255, 0.8);
      text-decoration: none;
      transition: color 0.3s ease;
      font-size: 0.9rem;
    }

    .footer-section a:hover {
      color: var(--um-yellow);
    }

    .footer-section p {
      color: rgba(255, 255, 255, 0.8);
      line-height: 1.7;
      font-size: 0.9rem;
    }

    .social-links {
      display: flex;
      gap: 0.75rem;
      margin-top: 1.25rem;
    }

    .social-links a {
      width: 38px;
      height: 38px;
      background: rgba(255, 255, 255, 0.1);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: all 0.3s ease;
      border: 1px solid rgba(255, 255, 255, 0.2);
    }

    .social-links a:hover {
      background: var(--um-yellow);
      color: var(--newspaper-border);
      transform: translateY(-2px);
    }

    .footer-bottom {
      padding-top: 1.5rem;
      border-top: 1px solid rgba(255, 255, 255, 0.2);
      text-align: center;
      color: rgba(255, 255, 255, 0.6);
      font-size: 0.85rem;
    }

    /* Scroll Animation */
    .scroll-animate {
      opacity: 0;
      transform: translateY(20px);
      transition: all 0.6s ease;
    }

    .scroll-animate.show {
      opacity: 1;
      transform: translateY(0);
    }

    /* Responsive */
    @media (max-width: 768px) {
      .masthead-title {
        font-size: 2.2rem;
        letter-spacing: 1px;
      }

      .masthead-subtitle {
        font-size: 0.75rem;
      }

      .newspaper-columns {
        column-gap: 2rem;
      }

      .article {
        padding-bottom: 1.5rem;
        margin-bottom: 2rem;
      }

      .article-title {
        font-size: 1.3rem;
      }

      .section-header {
        font-size: 1.2rem;
        flex-direction: column;
        align-items: flex-start;
        gap: 0.5rem;
      }
    }

    /* Print styles */
    @media print {
      body {
        background: white;
      }

      .navbar,
      footer,
      .scroll-animate {
        display: none;
      }

      .article {
        page-break-inside: avoid;
      }

      .newspaper-columns {
        column-count: 3;
      }
    }
  </style>

